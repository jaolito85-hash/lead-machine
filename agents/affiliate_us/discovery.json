{
  "niche": "weight_loss",
  "market": "US",
  "language": "en",
  "_comment": "Config de DESCOBERTA de intent. O agente de coleta usa isto pra saber onde procurar, o que procurar e como pontuar a intencao. Edite livremente.",

  "subreddits": [
    "loseit",
    "WeightLossAdvice",
    "1200isplenty",
    "intermittentfasting",
    "CICO",
    "xxfitness",
    "PCOS",
    "Supplements"
  ],

  "intent_queries": [
    "what actually helped you lose weight",
    "best supplement for weight loss",
    "anything that curbs appetite",
    "struggling to lose weight what worked for you",
    "looking for something to help with cravings",
    "over the counter GLP-1 alternative",
    "metabolism booster recommendations",
    "what protein shake do you recommend",
    "any product that helped you stay full"
  ],

  "intent_rubric": {
    "_scale": "0.0 (ruido) a 1.0 (comprando agora)",
    "buying":      { "min_score": 0.80, "signals": ["asking for product recommendation", "what should I buy", "willing to pay", "looking for a product/supplement"] },
    "researching": { "min_score": 0.50, "signals": ["comparing options", "does X actually work", "any reviews", "is X worth it"] },
    "frustrated":  { "min_score": 0.30, "signals": ["nothing works", "tried everything", "current product stopped working"] },
    "noise":       { "max_score": 0.20, "signals": ["off-topic", "venting without product intent", "selling something"] }
  },

  "safety_exclusions": {
    "_comment": "NUNCA gerar outreach pra estes casos — etica + risco legal. O classificador marca e descarta.",
    "drop_if": [
      "eating_disorder_signals",
      "minor_or_under_18",
      "pregnancy_or_breastfeeding",
      "medical_condition_or_medication_mentioned",
      "explicit_request_for_no_dms"
    ]
  },

  "limits": {
    "max_posts_per_query": 25,
    "max_comments_per_post": 50,
    "max_signals_per_run": 100
  }
}
