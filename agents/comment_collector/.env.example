# Copie este arquivo para .env e preencha
# IMPORTANTE: nunca comite o .env no Git

# Token do Apify (pegar em https://console.apify.com/account/integrations)
APIFY_TOKEN=

# OPCIONAL: chave da Anthropic para classificacao com IA de verdade
# Se vazio, o classifier usa heuristica de keywords (funciona, mas menos preciso)
ANTHROPIC_API_KEY=

# Modelo a usar (default: claude-haiku-4-5-20251001 — barato e rapido pra classificar)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Quantos comentarios por video (Apify limita ~1000)
MAX_COMMENTS_PER_VIDEO=500

# Perfil padrao da Carol
DEFAULT_PROFILE_INSTAGRAM=dracarolpantaleao
DEFAULT_PROFILE_TIKTOK=dracarolpantaleao
